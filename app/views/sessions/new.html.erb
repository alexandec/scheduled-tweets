<h1>Sign In</h1>

<%= form_with url: sign_in_path do |form| %>
  <div class="mb-3">
    <%= form.label :email %>
    <%= form.email_field :email %>
  </div>
  <div class="mb-3">
    <%= form.label :password %>
    <%= form.password_field :password %>
  </div>
  <div class="mb-3">
    <%= form.submit "Sign In", class: "btn btn-primary" %>
  </div>
<% end %>

<%= link_to "Sign Up", sign_up_path %>